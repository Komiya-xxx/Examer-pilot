{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExamerFrame question batch",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/question" },
  "$defs": {
    "nonBlankText": {
      "type": "string",
      "pattern": "\\S",
      "not": { "pattern": "[\\u0000\\uD800-\\uDFFF]" }
    },
    "option": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankText" },
        "text": { "$ref": "#/$defs/nonBlankText" }
      }
    },
    "question": {
      "type": "object",
      "required": ["external_id", "version_no", "question_type", "stem", "options"],
      "additionalProperties": false,
      "properties": {
        "external_id": { "$ref": "#/$defs/nonBlankText" },
        "version_no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "question_type": {
          "enum": ["single_choice", "multiple_choice", "true_false"]
        },
        "stem": { "$ref": "#/$defs/nonBlankText" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        }
      },
      "if": {
        "required": ["question_type"],
        "properties": { "question_type": { "const": "true_false" } }
      },
      "then": { "properties": { "options": { "maxItems": 0 } } },
      "else": { "properties": { "options": { "minItems": 2 } } }
    }
  }
}
