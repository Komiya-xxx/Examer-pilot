# ExamerFrame public build-time variables.
#
# Copy to `.env` for local development and fill in the values for your own
# local Supabase stack. Never commit a real `.env`; CI/Pages pass the same
# names as environment variables from repository configuration.
#
# PUBLIC_* values are embedded in the published static site. Only the
# publishable key (`sb_publishable_...`) belongs here — never a
# service_role key or `sb_secret_...` key.

# --- Supabase (GitHub repository variables: PUBLIC_SUPABASE_URL,
#     PUBLIC_SUPABASE_PUBLISHABLE_KEY) -----------------------------------
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- GitHub Pages deployment (not required locally) ----------------------
# Origin (https://...) and base path ("/" or "/<repo>/") provided by
# actions/configure-pages; the Pages workflow fails on invalid values.
EXAMERFRAME_SITE_URL=
EXAMERFRAME_BASE_PATH=

# --- Privacy notice (GitHub repository variables:
#     EXAMERFRAME_PRIVACY_RETENTION, EXAMERFRAME_PRIVACY_CONTACT) --------
# Approved public text only. The retention text describes how long data is
# kept; the contact text describes how to ask questions or request deletion.
# When either is blank the page states that the policy is pending approval.
EXAMERFRAME_PRIVACY_RETENTION=
EXAMERFRAME_PRIVACY_CONTACT=
