---
import {
  EXAMERFRAME_PRIVACY_RETENTION,
  EXAMERFRAME_PRIVACY_CONTACT,
  EXAMERFRAME_ACCOUNT_RETENTION,
  EXAMERFRAME_STUDY_RETENTION,
  EXAMERFRAME_OPINION_RETENTION,
} from "astro:env/server";
import "../styles/participant.css";

const contact = EXAMERFRAME_PRIVACY_CONTACT?.trim();
const contactEmail = contact?.match(/^[\w.+-]+@[\w-]+(?:\.[\w-]+)+$/)?.[0];
const retention = EXAMERFRAME_PRIVACY_RETENTION?.trim() ?? "试点结束后 30 天内删除匿名答题记录。";
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="法医病理学复习练习。选题作答、查看解析，跨设备继续复习。" />
    <title>法医病理学</title>
  </head>
  <body>
    <main class="quiz-shell student-shell">
      <header class="quiz-hero">
        <h1>法医病理学</h1>
        <p class="student-hero-description">选择题与判断题复习</p>
      </header>

      <section id="student-auth" class="student-panel" aria-labelledby="student-auth-title">
        <h2 id="student-auth-title">学生登录</h2>
        <p>用自定账户名和密码参加试点。登录后可以在不同设备找回复习进度和错题。</p>
        <form id="student-auth-form" method="post">
          <div class="student-field">
            <label for="student-username">账户名</label>
            <input id="student-username" type="text" autocomplete="username" autocapitalize="off"
              spellcheck="false" maxlength="64" required />
          </div>
          <div class="student-field">
            <label for="student-password">密码</label>
            <input id="student-password" type="password" autocomplete="current-password" maxlength="72" required />
          </div>
          <p id="student-auth-help" hidden>账户名 3–32 个字符。密码至少 8 个字符、最多 72 字节。</p>
          <div class="student-actions">
            <button id="student-auth-submit" class="primary-button" type="submit" disabled>登录</button>
            <button id="student-auth-switch" class="secondary-button" type="button" disabled>注册新账户</button>
            <button id="student-reconnect" class="secondary-button" type="button" hidden>重试恢复会话</button>
          </div>
        </form>
        <p id="student-auth-status" role="status"></p>
        <noscript>请启用 JavaScript 后登录。</noscript>
      </section>

      <section id="student-practice" class="student-practice" aria-labelledby="student-practice-title" hidden>
        <div class="student-panel student-account">
          <div>
            <h2 id="student-practice-title" tabindex="-1">复习</h2>
            <p>账户 <strong id="student-account-name"></strong></p>
            <p class="student-account-id">账户 ID <code id="student-account-id"></code></p>
          </div>
          <button id="student-sign-out" class="secondary-button" type="button">退出登录</button>
        </div>

        <div class="student-panel student-nav">
          <div class="student-actions" role="group" aria-label="复习范围">
            <button id="student-catalog" class="secondary-button" type="button" aria-pressed="true">全部题目</button>
            <button id="student-history" class="secondary-button" type="button" aria-pressed="false">我的作答</button>
            <button id="student-mistakes" class="secondary-button" type="button" aria-pressed="false">我的错题</button>
          </div>

          <form id="student-search-form" class="student-inline-form" role="search" aria-label="搜索题目">
            <div class="student-field">
              <label for="student-search">搜索题目</label>
              <input id="student-search" type="search" maxlength="200" placeholder="输入题号、题干或选项文字" />
            </div>
            <button class="primary-button" type="submit">搜索</button>
            <button id="student-clear-search" class="secondary-button" type="button" hidden>清除搜索</button>
          </form>

          <nav class="student-pager" aria-label="分页">
            <button id="student-prev" class="secondary-button" type="button" disabled>上一页</button>
            <p id="student-page"></p>
            <button id="student-next" class="secondary-button" type="button" disabled>下一页</button>
            <form id="student-jump-form" class="student-jump" novalidate>
              <label for="student-jump-page">页码</label>
              <input id="student-jump-page" type="number" min="1" step="1" inputmode="numeric" required />
              <button class="secondary-button" type="submit">跳转</button>
            </form>
          </nav>
          <p id="student-browse-status" role="status"></p>
          <button id="student-browse-retry" class="secondary-button" type="button" hidden>重试载入</button>
        </div>

        <section id="student-summary" class="student-panel student-summary" aria-labelledby="student-summary-title" hidden>
          <h3 id="student-summary-title">本页小结</h3>
          <dl class="student-stats">
            <div><dt>已答</dt><dd id="student-answered">0</dd></div>
            <div><dt>答对</dt><dd id="student-correct">0</dd></div>
            <div><dt>答错</dt><dd id="student-wrong-count">0</dd></div>
            <div><dt>暂不可判</dt><dd id="student-ungraded">0</dd></div>
            <div><dt>未答</dt><dd id="student-unanswered">0</dd></div>
            <div><dt>正确率</dt><dd id="student-accuracy">暂无可判分题</dd></div>
          </dl>
          <label class="student-filter"><input id="student-wrong-only" type="checkbox" />只看错题</label>
        </section>

        <section id="student-search-results" class="student-panel" aria-labelledby="student-results-title" hidden>
          <h3 id="student-results-title" tabindex="-1">搜索结果</h3>
          <ul id="student-matches"></ul>
        </section>
        <p id="student-filter-status" role="status" hidden>本页还没有错题。</p>
        <div id="student-questions" class="student-questions" aria-label="题目"></div>
        <nav id="student-bottom-pager" class="student-pager" aria-label="页尾分页" hidden>
          <button id="student-bottom-prev" class="secondary-button" type="button" disabled>上一页</button>
          <button id="student-bottom-next" class="secondary-button" type="button" disabled>下一页</button>
        </nav>
      </section>

      <footer class="student-footer">
        <button id="show-privacy" class="secondary-button" type="button">试点说明与隐私</button>
        <a href={base + "admin-review/"}>审查入口</a>
      </footer>
    </main>

    <template id="student-question-template">
      <article class="question-card student-question">
        <header class="student-question-heading">
          <h3 data-identifier tabindex="-1"></h3>
          <p data-question-type class="question-type"></p>
        </header>
        <p data-stem class="question-stem"></p>
        <form data-answer-form>
          <fieldset data-answer-options>
            <legend class="visually-hidden">选择答案</legend>
            <ol class="choice-list" data-options></ol>
          </fieldset>
          <div class="student-actions">
            <button data-submit-answer class="primary-button" type="submit" disabled>提交答案</button>
          </div>
        </form>
        <div data-review-panel hidden>
          <ol class="student-saved-options" data-saved-options></ol>
          <div class="student-actions" data-review-actions hidden>
            <button data-open-review class="secondary-button" type="button">查看错题详情</button>
            <button data-start-retry class="secondary-button" type="button" hidden>遮住答案再练一次</button>
            <button data-cancel-retry class="secondary-button" type="button" hidden>取消复练</button>
          </div>
          <section data-verdict-panel class="answer-review" aria-label="答案与解析" hidden>
            <h4 data-verdict></h4>
            <dl class="student-answer-detail">
              <div><dt>首次选择</dt><dd data-saved-answer></dd></div>
              <div><dt>标准答案</dt><dd data-standard-answer></dd></div>
              <div><dt>解析</dt><dd data-explanation></dd></div>
            </dl>
            <p data-review-time class="student-record"></p>
            <p data-retry-result class="student-record"></p>
          </section>
          <section data-feedback class="student-feedback" aria-label="题目反馈" hidden>
            <div class="student-actions">
              <h4>题目质量</h4>
              <button data-rating="low" class="secondary-button" type="button">低</button>
              <button data-rating="high" class="secondary-button" type="button">高</button>
              <span data-saved-rating></span>
            </div>
            <form data-comment-form novalidate>
              <label class="student-field">
                反馈意见（可选）
                <textarea data-comment-input rows="3" maxlength="2000"></textarea>
              </label>
              <button class="secondary-button" type="submit">提交意见</button>
            </form>
            <p data-saved-comment class="student-comment" hidden></p>
            <p data-feedback-status role="status"></p>
          </section>
        </div>
        <p data-answer-status role="status"></p>
      </article>
    </template>

    <dialog id="privacy" class="notice-dialog" aria-labelledby="privacy-title">
      <h2 id="privacy-title" autofocus>试点说明与隐私</h2>
      <div class="notice-content">
        <p>我们用账户名和账户 ID 识别登录，使用首答、错题、回看与复练记录恢复学习进度。自愿提交的等级和文字意见供授权编辑修订相应版本的题目。</p>
        <p>注册无需姓名、邮箱或手机号。填写意见时请勿附上个人信息。</p>
        <h3>资料保留</h3>
        <ul class="student-retention">
          <li>账户资料 {EXAMERFRAME_ACCOUNT_RETENTION?.trim() ?? "随本地测试账户清理。"}</li>
          <li>学习记录 {EXAMERFRAME_STUDY_RETENTION?.trim() ?? "随本地测试账户清理。"}</li>
          <li>等级与文字意见 {EXAMERFRAME_OPINION_RETENTION?.trim() ?? "随本地测试账户清理。"}</li>
          <li>旧匿名记录 {retention}</li>
        </ul>
        <h3>删除途径</h3>
        {contact ? (
          <p>申请删除请附上账户 ID，并联系 {contactEmail ? <a href={"mailto:" + contactEmail}>{contactEmail}</a> : contact}。</p>
        ) : (
          <p>本地测试账户由测试环境的管理员清理。</p>
        )}
      </div>
      <form method="dialog" class="notice-actions">
        <button class="primary-button" type="submit">关闭</button>
      </form>
    </dialog>

    <script>
      import "../scripts/participant-lobby";
    </script>
  </body>
</html>
