---
import { EXAMERFRAME_PRIVACY_RETENTION, EXAMERFRAME_PRIVACY_CONTACT } from "astro:env/server";
import "../styles/participant.css";

const retention = EXAMERFRAME_PRIVACY_RETENTION?.trim();
const contact = EXAMERFRAME_PRIVACY_CONTACT?.trim();
const contactEmail = contact?.match(/[\w.+-]+@[\w-]+(?:\.[\w-]+)+/)?.[0];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="法医病理学复习练习：自由选题，作答后查看答案与解析。" />
    <title>法医病理学</title>
  </head>
  <body>
    <main class="quiz-shell">
      <header class="quiz-hero">
        <h1>法医病理学</h1>
        <div class="type-menu" role="group" aria-label="题型">
          <button type="button" data-practice-type="choice" aria-pressed="true">选择题</button>
          <button type="button" data-practice-type="fill" aria-pressed="false">填空题</button>
          <button type="button" data-practice-type="true-false" aria-pressed="false">判断题</button>
          <button type="button" data-practice-type="term" aria-pressed="false">名词解释</button>
          <button type="button" data-practice-type="updates" aria-pressed="false">更新中</button>
        </div>
        <p id="type-status" role="status"></p>
      </header>

      <section id="saved-session" class="session-strip" aria-labelledby="session-title" hidden>
        <div class="session-summary">
          <h2 id="session-title">答题进度</h2>
          <p id="session-progress"></p>
          <button id="next-set" class="secondary-button" type="button" hidden>换一组题</button>
        </div>
        <ol id="question-map" class="question-map" aria-label="题目进度"></ol>
        <p id="next-set-status" role="status"></p>
      </section>

      <div id="status-card" class="status-card">
        <p id="lobby-status" role="status">正在准备复习题单…</p>
        <button id="enter-lobby" class="secondary-button" type="button" hidden>重试</button>
        <noscript>请启用 JavaScript 以匿名参与。</noscript>
      </div>

      <article id="current-question" class="question-card" aria-labelledby="question-progress" hidden>
        <div class="question-heading">
          <h2 id="question-progress" tabindex="-1"></h2>
          <p id="question-type" class="question-type"></p>
        </div>
        <p id="question-stem" class="question-stem"></p>

        <form id="answer-form" novalidate>
          <div class="answer-content">
            <fieldset id="answer-options">
              <legend class="visually-hidden">选择答案</legend>
              <ol id="question-options" class="choice-list"></ol>
            </fieldset>
            <ol id="review-options" class="choice-list" aria-label="已作答题目的选项" hidden></ol>

            <section id="answer-review" class="answer-review" aria-labelledby="answer-verdict" hidden>
              <h3 id="answer-verdict" tabindex="-1" role="status"></h3>
              <h4 class="answer-review-label">标准答案</h4>
              <p id="standard-answer"></p>
              <h4 class="answer-review-label">解析</h4>
              <p id="answer-explanation"></p>
              <h4 class="answer-review-label">你的选择</h4>
              <p id="saved-answer"></p>
            </section>
          </div>

          <div class="question-side">
            <fieldset id="rating-options" class="quality-panel" aria-describedby="quality-purpose quality-feedback" hidden>
              <legend>题目整体质量 <span class="quality-optional">（可选）</span></legend>
              <p id="quality-purpose" class="quality-purpose">您的评价将会改善后续的题目质量</p>
              <div class="quality-choices">
                <label class="quality-choice"><input type="radio" name="quality" value="low" /> <span>低</span></label>
                <label class="quality-choice"><input type="radio" name="quality" value="medium" /> <span>中</span></label>
                <label class="quality-choice"><input type="radio" name="quality" value="high" /> <span>高</span></label>
              </div>
              <p id="quality-feedback" class="quality-feedback" role="status">不选时按「中」记录。</p>
              <div class="quality-actions">
                <button id="save-rating" class="secondary-button" type="button" disabled>保存评价</button>
              </div>
            </fieldset>

            <div class="question-actions">
              <button id="submit-answer" class="primary-button" type="submit" disabled>提交答案</button>
              <p id="question-status" role="status"></p>
            </div>
          </div>
        </form>
      </article>
    </main>

    <dialog id="privacy" class="notice-dialog" aria-labelledby="privacy-title">
      <p class="notice-kicker">参与前，请了解</p>
      <h2 id="privacy-title" tabindex="-1" autofocus>试点公告</h2>
      <div class="notice-content">
        <h3>隐私说明</h3>
        <p>页面打开后会尝试创建或恢复匿名会话，无需姓名、邮箱或手机号。我们保存匿名标识、你提交的答案和评价，以及提交时间。同一浏览器可恢复进度；清除浏览器数据或换设备后，原会话可能无法恢复。</p>
        <h3>评价如何使用</h3>
        <p>我们汇总评价，筛选适合后续正式题库的题目。评价也可能影响试点中的发放概率；未主动选择时，本题按「中」记录。</p>
        <h3>保存期限与联系方式</h3>
        {retention && contact ? (
          <>
            <p>数据保存期限：{retention}</p>
            <p>隐私问题与数据删除：{contactEmail === contact ? <a href={`mailto:${contact}`}>{contact}</a> : contact}</p>
          </>
        ) : (
          <p>本地测试环境。试点开放前将在此公布数据保存期限、联系方式与删除途径。</p>
        )}
      </div>
      <form method="dialog" class="notice-actions">
        <button id="dismiss-privacy" class="primary-button" type="submit">知道了，关闭公告</button>
      </form>
    </dialog>

    {contact && (
      <footer class="contact-footer">
        联系方式：{contactEmail ? <a href={`mailto:${contactEmail}`}>{contactEmail}</a> : contact}
      </footer>
    )}

    <script>
      import "../scripts/participant-lobby";
    </script>
  </body>
</html>
