---
import "../styles/participant.css";
import "../styles/admin-review.css";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="题目审查入口：输入审查密钥后查看题目的标准答案与解析，并评价题目质量。" />
    <title>题目审查 · 法医病理学</title>
  </head>
  <body>
    <main class="quiz-shell staff-shell">
      <header class="quiz-hero staff-hero">
        <p class="notice-kicker">管理人员</p>
        <h1>题目审查</h1>
        <p class="staff-intro">输入审查密钥查看标准答案与解析，并评价题目质量。</p>
      </header>

      <section id="staff-login" class="staff-login-card" aria-labelledby="staff-login-title">
        <h2 id="staff-login-title">审查登录</h2>
        <form id="staff-login-form" method="post" novalidate>
          <div class="staff-field">
            <label for="staff-key">审查密钥</label>
            <input
              id="staff-key"
              type="password"
              autocomplete="current-password"
              autocapitalize="off"
              spellcheck="false"
              required
              aria-describedby="staff-status"
            />
          </div>
          <div class="staff-login-actions">
            <button class="primary-button" type="submit" disabled>进入审查</button>
            <a class="staff-back-link" href={base}>返回答题页</a>
          </div>
        </form>
      </section>

      <p id="staff-status" class="staff-status" role="status" aria-live="polite"></p>

      <section id="staff-review" class="staff-review" aria-labelledby="staff-review-title" hidden>
        <header class="staff-review-head">
          <h2 id="staff-review-title" tabindex="-1">待审查题目</h2>
          <button id="staff-exit" class="secondary-button" type="button">退出审查</button>
        </header>

        <form id="staff-search-form" class="staff-search" role="search" aria-label="搜索题目">
          <div class="staff-field">
            <label for="staff-search">搜索题目</label>
            <input id="staff-search" class="staff-input" type="search" maxlength="200"
              placeholder="输入题号、题干或选项文字" autocomplete="off" />
          </div>
          <button class="primary-button" type="submit">搜索</button>
          <button id="staff-clear-search" class="secondary-button" type="button" hidden>清除搜索</button>
        </form>

        <p id="staff-browse-status" class="staff-status" role="status" aria-live="polite"></p>

        <nav class="staff-pager" aria-label="题目分页">
          <button id="staff-prev" class="secondary-button" type="button" disabled>上一页</button>
          <p id="staff-page" class="staff-page"></p>
          <button id="staff-next" class="secondary-button" type="button" disabled>下一页</button>
          <form id="staff-jump-form" class="staff-jump" novalidate>
            <label for="staff-jump-page">跳至第</label>
            <input id="staff-jump-page" class="staff-input" type="number" min="1" step="1" inputmode="numeric"
              aria-label="跳转页码" aria-describedby="staff-page" required disabled />
            <span aria-hidden="true">页</span>
            <button class="secondary-button" type="submit" disabled>跳转</button>
          </form>
        </nav>

        <section id="staff-search-results" class="staff-results" aria-labelledby="staff-results-title" hidden>
          <h3 id="staff-results-title" tabindex="-1">搜索结果</h3>
          <ul id="staff-matches" class="staff-matches"></ul>
        </section>
        <div id="staff-questions" class="staff-questions" role="list" aria-label="待审查题目"></div>
        <nav id="staff-bottom-pager" class="staff-pager staff-bottom-pager" aria-label="页尾题目分页" hidden>
          <button id="staff-bottom-prev" class="secondary-button" type="button" disabled>上一页</button>
          <button id="staff-bottom-next" class="secondary-button" type="button" disabled>下一页</button>
        </nav>

        <section id="staff-feedback" class="staff-feedback" aria-labelledby="staff-feedback-title">
          <h3 id="staff-feedback-title" tabindex="-1">学生反馈</h3>
          <form id="staff-feedback-form" class="staff-feedback-form" novalidate>
            <div class="staff-field">
              <label for="staff-feedback-id">题目编号</label>
              <input id="staff-feedback-id" class="staff-input" type="text" maxlength="200"
                placeholder="输入题目编号" autocomplete="off" required />
            </div>
            <div class="staff-field">
              <label for="staff-feedback-version">版本号</label>
              <input id="staff-feedback-version" class="staff-input" type="number" min="1" step="1"
                inputmode="numeric" aria-label="题目版本号" required />
            </div>
            <button id="staff-feedback-load" class="primary-button" type="submit">查看反馈</button>
          </form>
          <p id="staff-feedback-status" class="staff-status" role="status" aria-live="polite"></p>
          <div id="staff-feedback-result" class="staff-feedback-result" hidden>
            <p class="staff-feedback-summary">
              低 <span id="staff-feedback-low">0</span> 票 · 高 <span id="staff-feedback-high">0</span> 票
              · 文字意见 <span id="staff-feedback-comment-count">0</span> 条
            </p>
            <dl id="staff-feedback-history" class="staff-feedback-history">
              <div class="staff-feedback-history-row">
                <dt>旧版主动评价</dt>
                <dd>低 <span id="staff-history-explicit-low">0</span> · 中 <span id="staff-history-explicit-medium">0</span>
                  · 高 <span id="staff-history-explicit-high">0</span></dd>
              </div>
              <div class="staff-feedback-history-row">
                <dt>旧版默认评价</dt>
                <dd>低 <span id="staff-history-default-low">0</span> · 中 <span id="staff-history-default-medium">0</span>
                  · 高 <span id="staff-history-default-high">0</span></dd>
              </div>
              <div class="staff-feedback-history-row">
                <dt>旧版历史评价（legacy）</dt>
                <dd>低 <span id="staff-history-legacy-low">0</span> · 中 <span id="staff-history-legacy-medium">0</span>
                  · 高 <span id="staff-history-legacy-high">0</span></dd>
              </div>
            </dl>
            <ul id="staff-feedback-comments" class="staff-feedback-comments"></ul>
          </div>
        </section>
      </section>
    </main>

    <template id="staff-question-template">
      <article class="question-card staff-card" role="listitem">
        <h3 class="staff-card-id" data-staff-identifier></h3>
        <p class="question-stem" data-staff-stem></p>
        <ol class="staff-option-list" data-staff-options></ol>

        <section class="answer-review staff-answer" aria-label="答案与解析">
          <h4 class="answer-review-label">标准答案</h4>
          <p data-staff-answer></p>
          <h4 class="answer-review-label">解析</h4>
          <p data-staff-explanation></p>
        </section>

        <form class="staff-rating" data-staff-rating-form novalidate>
          <fieldset class="quality-panel">
            <legend>题目质量 <span class="quality-optional">（可选）</span></legend>
            <div class="quality-choices">
              <label class="quality-choice">
                <input type="radio" name="quality" value="low" />
                <span>低</span>
              </label>
              <label class="quality-choice">
                <input type="radio" name="quality" value="medium" />
                <span>中</span>
              </label>
              <label class="quality-choice">
                <input type="radio" name="quality" value="high" />
                <span>高</span>
              </label>
            </div>
            <div class="quality-actions">
              <button class="secondary-button" type="submit">保存评价</button>
            </div>
            <p class="quality-feedback" data-staff-rating-status role="status" aria-live="polite"></p>
          </fieldset>
        </form>

        <div class="staff-card-actions">
          <button type="button" class="secondary-button" data-staff-feedback-button>查看学生反馈</button>
        </div>
      </article>
    </template>

    <script>
      import "../scripts/admin-review.ts";
    </script>
  </body>
</html>
